<!-- views/profil.ejs -->
<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Montserrat:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Montserrat', 'sans-serif'],
            serif: ['"Instrument Serif"', 'serif'],
          },
          colors: {
            wd: { bg: '#0b0418', deep: '#1b0a3c', mid: '#2e1065', accent: '#9b30ff' },
          },
        },
      },
    };
  </script>
</head>

<body class="bg-wd-bg text-white font-sans antialiased">
  <div class="max-w-6xl mx-auto p-4 md:p-6 space-y-5">

    <!-- HERO -->
    <header
      class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-wd-mid to-wd-deep min-h-[520px] flex flex-col">
      <img src="./images/stmik.jpg" alt="" class="absolute inset-0 w-full h-full object-cover opacity-25">
      <div class="absolute inset-0 bg-gradient-to-b from-wd-deep/60 to-wd-bg/80"></div>

      <nav class="relative z-10 flex items-center justify-between px-6 md:px-10 py-5">
        <a href="/profil" class="flex items-center gap-2">
          <img src="./images/W.jpg" alt="Logo STMIK Wicida" class="w-10 h-10 rounded-full">
          <span class="leading-tight text-xs font-bold">STMIK<br><span
              class="font-normal text-[10px] text-white/70">WICIDA</span></span>
        </a>
        <div class="hidden md:flex items-center gap-8 text-xs text-white/80">
          <% navLinks.forEach(l=> { %><a href="<%= l.href %>" class="hover:text-white">
              <%= l.label %>
            </a>
            <% }); %>
        </div>
        <a href="/pmb"
          class="text-[11px] border border-white/60 rounded-full px-4 py-1.5 hover:bg-white hover:text-wd-deep transition">Daftar
          Sekarang ↗</a>
      </nav>

      <div class="relative z-10 flex-1 flex flex-col justify-end px-6 md:px-10 pb-8">
        <h1 class="text-4xl md:text-6xl font-semibold leading-tight max-w-3xl">
          STMIK <span class="font-serif italic font-normal text-wd-accent">Widya Cipta Dharma</span> Samarinda
        </h1>
        <div class="mt-6 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div class="max-w-xl text-xs text-white/80 space-y-2">
            <p class="font-semibold text-white">STMIK Widya Cipta Dharma<br>Sekolah Tinggi Manajemen Informatika dan
              Komputer</p>
            <p>Perguruan tinggi bidang teknologi informasi yang mencetak lulusan unggul, inovatif, dan siap bersaing di
              era digital.</p>
            <a href="#kontak" class="inline-block underline text-white/90">Hubungi Kami →</a>
          </div>
          <a href="/pmb"
            class="self-start md:self-end text-[11px] tracking-wider border border-white/70 rounded-full px-5 py-2 hover:bg-white hover:text-wd-deep transition">DAFTAR
            SEKARANG ↗</a>
        </div>
      </div>
    </header>

    <!-- TOP FEATURES -->
    <section class="grid md:grid-cols-2 gap-5">
      <% features.forEach(f=> { %>
        <article
          class="relative overflow-hidden rounded-3xl border border-white/10 bg-wd-deep min-h-[220px] flex flex-col justify-end p-6">
          <img src="<%= f.img %>" alt="<%= f.title %>" class="absolute inset-0 w-full h-full object-cover opacity-30">
          <div class="absolute inset-0 bg-gradient-to-t from-wd-bg/90 via-wd-deep/60 to-transparent"></div>
          <div class="relative">
            <h3 class="text-lg font-medium">
              <%= f.title %>
            </h3>
            <p class="mt-2 text-[11px] leading-relaxed text-white/75">
              <%= f.desc %>
            </p>
            <div class="mt-4 flex gap-2">
              <% f.tags.forEach(t=> { %>
                <span class="text-[10px] border border-white/50 rounded-full px-3 py-0.5">
                  <%= t %>
                </span>
                <% }); %>
            </div>
          </div>
        </article>
        <% }); %>
    </section>

    <!-- PROGRAM STUDI -->
    <% prodi.forEach(p=> { %>
      <section class="<%= p.theme.card %> rounded-3xl p-6 md:p-8 grid md:grid-cols-2 gap-6">
        <div class="flex flex-col justify-between order-2 md:order-1">
          <div>
            <p class="text-[10px] tracking-widest uppercase <%= p.theme.label %>">Program Studi</p>
            <% if (p.tagsFirst) { %>
              <div class="mt-3 flex flex-wrap gap-2">
                <% p.tags.forEach(t=> { %><span class="text-[10px] border <%= p.theme.tag %> rounded-full px-3 py-0.5">
                    <%= t %>
                  </span>
                  <% }); %>
              </div>
              <% } %>
                <h2 class="mt-3 text-4xl md:text-5xl font-serif leading-none">
                  <%= p.name %>
                </h2>
                <% if (!p.tagsFirst) { %>
                  <div class="mt-4 flex flex-wrap gap-2">
                    <% p.tags.forEach(t=> { %><span
                        class="text-[10px] border <%= p.theme.tag %> rounded-full px-3 py-0.5">
                        <%= t %>
                      </span>
                      <% }); %>
                  </div>
                  <% } %>
          </div>
          <div class="mt-10">
            <p class="text-[11px] leading-relaxed max-w-md">
              <%= p.desc %>
            </p>
            <a href="<%= p.name === 'Teknik Informatika' ? '/teknik-informatika' : '#' %>"
              class="inline-block mt-4 text-[10px] border <%= p.theme.btn %> rounded-full px-4 py-1 <%= p.name !== 'Teknik Informatika' ? 'pointer-events-none opacity-50' : '' %>">
              Info ↗
            </a>
          </div>
        </div>
        <div
          class="order-1 md:order-2 rounded-2xl overflow-hidden bg-black flex items-center justify-center h-72 md:h-80">
          <% if (p.circle) { %>
            <img src="<%= p.img %>" alt="<%= p.name %>"
              class="w-64 h-64 rounded-full object-cover border-8 border-green-400">
            <% } else { %>
              <img src="<%= p.img %>" alt="<%= p.name %>" class="w-full h-full object-cover">
              <% } %>
        </div>
      </section>
      <% }); %>

        <!-- VISI & MISI -->
        <section id="visi-misi"
          class="rounded-3xl border border-white/10 bg-wd-deep p-6 md:p-10 grid md:grid-cols-2 gap-8">
          <div>
            <p class="text-[10px] tracking-widest uppercase text-white/60">Visi</p>
            <h2 class="mt-2 text-3xl font-serif">Arah dan cita-cita</h2>
            <p class="mt-4 text-sm leading-relaxed text-white/80">
              <%= visi %>
            </p>
          </div>
          <div>
            <p class="text-[10px] tracking-widest uppercase text-white/60">Misi</p>
            <ol class="mt-4 space-y-3 text-sm text-white/80 list-decimal list-inside">
              <% misi.forEach(m=> { %><li>
                  <%= m %>
                </li>
                <% }); %>
            </ol>
          </div>
        </section>

        <!-- TENTANG -->
        <section id="tentang" class="bg-[#e9e0ff] text-[#1b0a3c] rounded-3xl p-6 md:p-10 grid md:grid-cols-2 gap-8">
          <h2 class="text-2xl md:text-3xl font-semibold">TENTANG:</h2>
          <ul class="divide-y divide-[#1b0a3c]/20 border-y border-[#1b0a3c]/20">
            <% about.forEach(a=> { %>
              <li>
                <a href="<%= a.href %>" class="flex items-center justify-between py-3">
                  <span>
                    <span class="block text-sm font-semibold">
                      <%= a.title %>
                    </span>
                    <span class="block text-[10px] text-[#1b0a3c]/70">
                      <%= a.sub %>
                    </span>
                  </span>
                  <span class="text-lg">↗</span>
                </a>
              </li>
              <% }); %>
          </ul>
        </section>

        <!-- CTA FOOTER -->
        <footer id="kontak"
          class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-wd-mid to-wd-deep min-h-[360px] flex flex-col">
          <img src="./images/stmik.jpg" alt="" class="absolute inset-0 w-full h-full object-cover opacity-25">
          <div class="absolute inset-0 bg-gradient-to-b from-wd-deep/50 to-wd-bg/80"></div>
          <div class="relative z-10 flex items-center justify-between px-6 md:px-10 py-5 text-xs">
            <span class="flex items-center gap-2 font-bold">
              <img src="./images/W.jpg" alt="Logo" class="w-8 h-8 rounded-full"> STMIK WICIDA
            </span>
            <span class="hidden md:flex gap-6 text-white/70">
              <% navLinks.forEach(l=> { %><a href="<%= l.href %>">
                  <%= l.label %>
                </a>
                <% }); %>
            </span>
          </div>
          <div class="relative z-10 flex-1 flex flex-col items-center justify-center text-center px-6 pb-10">
            <h2 class="text-4xl md:text-5xl font-medium leading-tight">
              Tertarik Masuk<br>
              <span class="font-serif italic font-normal text-wd-accent">STMIK WICIDA?</span>
            </h2>
            <a href="/pmb"
              class="mt-6 text-[11px] tracking-wider border border-white/70 rounded-full px-6 py-2 hover:bg-white hover:text-wd-deep transition">Daftar
              Sekarang ↗</a>
          </div>
        </footer>

  </div>
</body>

</html>