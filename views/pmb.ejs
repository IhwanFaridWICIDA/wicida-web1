<!-- views/pmb.ejs -->
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Montserrat', 'sans-serif'],
            serif: ['"Instrument Serif"', 'serif'],
          },
          colors: {
            wd: { bg: '#0b0418', deep: '#1b0a3c', mid: '#2e1065', accent: '#9b30ff', navy: '#14123f' },
          },
        },
      },
    };
  </script>
</head>
<body class="bg-wd-bg text-white font-sans antialiased">
  <div class="max-w-6xl mx-auto p-4 md:p-6 space-y-5">

    <!-- HERO BANNER -->
    <header class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-wd-mid to-wd-deep">
      <nav class="relative z-10 flex items-center justify-between px-6 md:px-10 py-5">
        <a href="/profil" class="flex items-center gap-2">
          <img src="./images/W.jpg" alt="Logo STMIK Wicida" class="w-10 h-10 rounded-full">
          <span class="leading-tight text-xs font-bold">STMIK<br><span class="font-normal text-[10px] text-white/70">WICIDA</span></span>
        </a>
        <div class="hidden md:flex items-center gap-8 text-xs text-white/80">
          <% navLinks.forEach(l => { %><a href="<%= l.href %>" class="hover:text-white"><%= l.label %></a><% }); %>
        </div>
        <a href="/profil" class="text-[11px] border border-white/60 rounded-full px-4 py-1.5 hover:bg-white hover:text-wd-deep transition">Daftar Sekarang ↗</a>
      </nav>

      <div class="relative z-10 grid md:grid-cols-2 gap-6 items-end px-6 md:px-10 pb-0">
        <div class="pb-10">
          <h1 class="text-4xl md:text-5xl font-semibold leading-tight">
            Penerimaan<br>
            <span class="font-serif italic font-normal text-wd-accent">Mahasiswa Baru</span> 2026
          </h1>
          <p class="mt-4 text-[11px] text-white/80 max-w-sm">
            STMIK Widya Cipta Dharma<br>Sekolah Tinggi Manajemen Informatika dan Komputer
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="#form" class="text-[11px] tracking-wider border border-white/70 rounded-full px-5 py-2 hover:bg-white hover:text-wd-deep transition">DAFTAR ONLINE ↗</a>
            <a href="#" class="text-[11px] tracking-wider border border-white/70 rounded-full px-5 py-2 hover:bg-white hover:text-wd-deep transition">DOWNLOAD BROSUR ↗</a>
          </div>
        </div>
        <div class="flex justify-center md:justify-end">
          <img src="./images/TIprofil.png" alt="Mahasiswa" class="h-64 md:h-72 object-cover rounded-t-3xl">
        </div>
      </div>
    </header>

    <!-- TIMELINE -->
    <section class="rounded-3xl bg-wd-navy border border-indigo-400/20 p-6 md:p-8">
      <h2 class="text-xl font-medium">Timeline Pendaftaran</h2>
      <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-4">
        <% steps.forEach(s => { %>
          <div class="rounded-xl border border-yellow-400/40 bg-[#1b1a5a] py-4 px-3 flex flex-col items-center text-center">
            <span class="w-8 h-8 rounded-full bg-yellow-400 text-wd-deep text-sm font-bold flex items-center justify-center"><%= s.n %></span>
            <span class="mt-3 text-xs font-semibold"><%= s.title %></span>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- KEUNGGULAN -->
    <section class="rounded-3xl bg-gradient-to-b from-wd-mid/60 to-wd-deep/40 border border-white/10 p-6 md:p-8">
      <h2 class="text-center text-3xl font-serif italic">Keunggulan</h2>
      <div class="mt-6 grid sm:grid-cols-2 gap-4">
        <% advantages.forEach(a => { %>
          <article class="rounded-2xl bg-wd-mid/70 border border-white/10 p-5 flex flex-col justify-between min-h-[150px]">
            <div>
              <h3 class="text-sm font-medium"><%= a.title %></h3>
              <p class="mt-3 text-[10px] leading-relaxed text-white/70"><%= a.desc %></p>
            </div>
            <div class="mt-4 flex gap-2">
              <% a.tags.forEach(t => { %><span class="text-[9px] border border-white/50 rounded-full px-3 py-0.5"><%= t %></span><% }); %>
            </div>
          </article>
        <% }); %>
      </div>
    </section>

    <!-- FORM + SIDEBAR -->
    <section id="form" class="rounded-3xl bg-[#e9e0ff] text-[#1b0a3c] p-6 md:p-8 grid md:grid-cols-2 gap-8">
      <div>
        <p class="text-[10px] tracking-widest uppercase text-[#1b0a3c]/70">Pendaftaran</p>
        <h2 class="mt-1 text-2xl font-medium">Form Pendaftaran</h2>
        <% if (sent) { %>
          <div class="mt-4 bg-green-100 text-green-800 px-4 py-2 rounded-xl text-xs">Pendaftaran berhasil dikirim. Terima kasih!</div>
        <% } %>
        <form action="/pmb" method="POST" class="mt-5 space-y-3">
          <div class="flex items-center gap-3">
            <label for="nama" class="w-16 text-[10px] font-semibold tracking-wider">NAMA</label>
            <input id="nama" name="nama" type="text" required class="flex-1 rounded-full bg-[#c9b6ff] px-4 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-wd-accent">
          </div>
          <div class="flex items-center gap-3">
            <label for="email" class="w-16 text-[10px] font-semibold tracking-wider">EMAIL</label>
            <input id="email" name="email" type="email" required class="flex-1 rounded-full bg-[#c9b6ff] px-4 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-wd-accent">
          </div>
          <div class="flex items-center gap-3">
            <label for="hp" class="w-16 text-[10px] font-semibold tracking-wider">NO. HP</label>
            <input id="hp" name="hp" type="tel" required class="flex-1 rounded-full bg-[#c9b6ff] px-4 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-wd-accent">
          </div>
          <div class="flex items-center gap-3">
            <label for="prodi" class="w-16 text-[10px] font-semibold tracking-wider">PRODI</label>
            <select id="prodi" name="prodi" required class="flex-1 rounded-full bg-[#c9b6ff] px-4 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-wd-accent">
              <option value="">Pilih Program Studi</option>
              <% prodiOptions.forEach(p => { %><option value="<%= p %>"><%= p %></option><% }); %>
            </select>
          </div>
          <button type="submit" class="mt-2 ml-auto block text-[10px] tracking-wider bg-wd-deep text-white rounded-full px-5 py-2 hover:bg-wd-mid transition">KIRIM FORM ↗</button>
        </form>
      </div>

      <aside class="rounded-2xl bg-gradient-to-br from-orange-500 via-pink-600 to-purple-700 p-4 flex items-center justify-center">
        <img src="./images/PMB.png" alt="Promo PMB" class="rounded-xl w-full max-w-[260px] object-cover">
      </aside>
    </section>

    <!-- CALLOUT BANNER -->
    <footer class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-wd-mid to-wd-deep min-h-[360px] flex flex-col">
      <img src="./images/stmik.jpg" alt="" class="absolute inset-0 w-full h-full object-cover opacity-25">
      <div class="absolute inset-0 bg-gradient-to-b from-wd-deep/50 to-wd-bg/80"></div>
      <div class="relative z-10 flex items-center justify-between px-6 md:px-10 py-5 text-xs">
        <span class="flex items-center gap-2 font-bold">
          <img src="./images/W.jpg" alt="Logo" class="w-8 h-8 rounded-full"> STMIK WICIDA
        </span>
        <span class="hidden md:flex gap-6 text-white/70">
          <% navLinks.forEach(l => { %><a href="<%= l.href %>"><%= l.label %></a><% }); %>
        </span>
      </div>
      <div class="relative z-10 flex-1 flex flex-col items-center justify-center text-center px-6 pb-10">
        <h2 class="text-4xl md:text-5xl font-medium leading-tight">
          Ingin Kunjungi Profil<br>
          <span class="font-serif italic font-normal text-wd-accent">STMIK WICIDA?</span>
        </h2>
        <a href="/profil" class="mt-6 text-[11px] tracking-wider border border-white/70 rounded-full px-6 py-2 hover:bg-white hover:text-wd-deep transition">WICIDA.AC.ID ↗</a>
      </div>
    </footer>

  </div>
</body>
</html>