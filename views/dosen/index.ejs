<!-- views/dosen/index.ejs -->
<%- include('../partials/header', { title }) %>

<section class="rounded-3xl bg-[#e9e0ff] text-[#1b0a3c] p-6 md:p-8">
  <p class="text-[10px] tracking-widest uppercase text-[#1b0a3c]/70">Program Studi</p>
  <h1 class="mt-2 text-4xl md:text-5xl font-serif">Daftar Dosen</h1>
  <p class="mt-3 text-xs text-[#1b0a3c]/70">
    Menampilkan <%= dosen.length %> dosen<% if (keahlian) { %> dengan keahlian <b><%= keahlian %></b><% } %>.
  </p>

  <div class="mt-5 flex flex-wrap gap-2">
    <a href="/dosen" class="text-[11px] rounded-full px-4 py-1 border border-[#1b0a3c]/40 <%= !keahlian ? 'bg-[#1b0a3c] text-white' : 'hover:bg-[#1b0a3c]/10' %>">Semua</a>
    <% semuaKeahlian.forEach(k => { %>
      <a href="/dosen?keahlian=<%= encodeURIComponent(k) %>"
         class="text-[11px] rounded-full px-4 py-1 border border-[#1b0a3c]/40 <%= keahlian && keahlian.toLowerCase() === k.toLowerCase() ? 'bg-[#1b0a3c] text-white' : 'hover:bg-[#1b0a3c]/10' %>"><%= k %></a>
    <% }); %>
  </div>
</section>

<% if (dosen.length === 0) { %>
  <section class="rounded-3xl border border-white/10 bg-wd-deep p-10 text-center text-sm text-white/70">
    Tidak ada dosen dengan keahlian tersebut. <a href="/dosen" class="underline">Lihat semua dosen</a>
  </section>
<% } else { %>
  <section class="grid md:grid-cols-2 gap-5">
    <% dosen.forEach(d => { %>
      <a href="/dosen/<%= d.nidn %>" class="rounded-3xl border border-white/10 bg-wd-deep p-6 flex gap-4 hover:border-wd-accent transition">
        <div class="w-14 h-14 shrink-0 rounded-full bg-wd-accent/30 flex items-center justify-center text-lg font-semibold">
          <%= d.nama.replace(/^(Dr\.|Prof\.)\s*/, '').charAt(0) %>
        </div>
        <div>
          <h2 class="text-base font-medium"><%= d.nama %></h2>
          <p class="text-[11px] text-white/60"><%= d.jabatan %> &middot; NIDN <%= d.nidn %></p>
          <div class="mt-3 flex flex-wrap gap-2">
            <% d.keahlian.forEach(k => { %><span class="text-[10px] border border-white/40 rounded-full px-3 py-0.5"><%= k %></span><% }); %>
          </div>
        </div>
      </a>
    <% }); %>
  </section>
<% } %>

<%- include('../partials/footer') %>
