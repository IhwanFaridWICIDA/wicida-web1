<!-- views/berita/index.ejs -->
<%- include('../partials/header', { title }) %>

<section class="rounded-3xl bg-[#e9e0ff] text-[#1b0a3c] p-6 md:p-8">
  <p class="text-[10px] tracking-widest uppercase text-[#1b0a3c]/70">Kategori: <%= kategori %></p>
  <h1 class="mt-2 text-4xl md:text-5xl font-serif">Berita Kampus</h1>
  <div class="mt-5 flex flex-wrap gap-2">
    <% kategoriBerita.forEach(k => { %>
      <a href="/berita/<%= k %>" class="text-[11px] capitalize rounded-full px-4 py-1 border border-[#1b0a3c]/40 <%= k === kategori ? 'bg-[#1b0a3c] text-white' : 'hover:bg-[#1b0a3c]/10' %>"><%= k %></a>
    <% }); %>
  </div>
</section>

<% if (daftar.length === 0) { %>
  <section class="rounded-3xl border border-white/10 bg-wd-deep p-10 text-center text-sm text-white/70">Belum ada berita di kategori ini.</section>
<% } else { %>
  <section class="space-y-4">
    <% daftar.forEach(b => { %>
      <article class="rounded-3xl border border-white/10 bg-wd-deep p-6">
        <div class="flex items-center gap-3 text-[10px] text-white/60">
          <span class="border border-white/40 rounded-full px-3 py-0.5 capitalize"><%= b.kategori %></span>
          <time datetime="<%= b.tanggal %>"><%= new Date(b.tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></time>
        </div>
        <h2 class="mt-3 text-lg font-medium"><%= b.judul %></h2>
        <p class="mt-2 text-xs text-white/75 leading-relaxed"><%= b.ringkas %></p>
      </article>
    <% }); %>
  </section>
<% } %>

<%- include('../partials/footer') %>
